# Copy to .env.local (never commit it) and set the same values in Vercel.
# Names only; the values are secret.

# --- Catalyst Data Store and Stratus (src/lib/catalyst.js) ---
PROJECT_ID=
PROJECT_KEY=
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=

# --- Zoho CRM (src/lib/zoho.js): leads, notes, cities, micro-markets ---
# The refresh token needs the Leads, Notes (ZohoCRM.modules.notes.CREATE) and
# City / Micromarkets read scopes.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# --- Zoho Sheet: "List your Property" submissions ---
ZOHO_SHEET_REFRESH_TOKEN=
ZOHO_SHEET_RESOURCE_ID=
ZOHO_SHEET_WORKSHEET=
# Optional (defaults: https://sheet.zoho.in and https://accounts.zoho.in)
ZOHO_SHEET_API_DOMAIN=
ZOHO_ACCOUNTS_DOMAIN=

# --- AI search (Google Gemini) ---
GEMINI_API_KEY=
# Optional
GEMINI_MODEL=
AI_SEARCH_DAILY_LIMIT=

# --- Site ---
# Public address of the site, used for the sitemap and canonical links.
NEXT_PUBLIC_BASE_URL=
# Proxies in front of the app that add to X-Forwarded-For (Vercel: 1).
TRUSTED_PROXY_COUNT=1

# --- Optional: Properties column holding the CRM record ID (default crmID) ---
CATALYST_CRM_ID_COLUMN=

# --- Optional: Cloudflare Turnstile bot check on every form (set both or neither) ---
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Optional: Upstash Redis, so rate limits are shared by all server instances ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional: cache times (seconds) and log detail (debug|info|warn|error) ---
PROPERTIES_CACHE_TTL=
CITIES_CACHE_TTL=
MICROMARKETS_CACHE_TTL=
LOG_LEVEL=
