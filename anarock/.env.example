# Copy this file to .env.local and fill in the values.
# Never commit .env.local or any file with real values.

# ---------------------------------------------------------------
# Zoho Catalyst (Data Store: properties, FAQs, city page tables)
# Used by src/lib/catalyst.js
# ---------------------------------------------------------------
PROJECT_ID=
PROJECT_KEY=
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=

# ---------------------------------------------------------------
# Zoho CRM (leads, cities, micro-markets)
# Used by src/lib/zoho.js and the leads, lead2, lead3 API routes
# ---------------------------------------------------------------
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Zoho CRM for the "List your Property" city/micro-market lookups.
# src/app/api/list-your-property/route.js reads these separate names.
# Either set ZOHO_CRM_ACCESS_TOKEN, or the three refresh-token values.
ZOHO_CRM_ACCESS_TOKEN=
ZOHO_CRM_CLIENT_ID=
ZOHO_CRM_CLIENT_SECRET=
ZOHO_CRM_REFRESH_TOKEN=
# Optional. Default: https://accounts.zoho.in
ZOHO_ACCOUNTS_DOMAIN=

# ---------------------------------------------------------------
# AI search (Google Gemini)
# Used by src/app/api/ai-search/route.js
# ---------------------------------------------------------------
GEMINI_API_KEY=
# Optional. Gemini model name; the route has a default.
GEMINI_MODEL=
# Optional. Max Gemini calls per server instance per day. Default: 2000
AI_SEARCH_DAILY_LIMIT=

# ---------------------------------------------------------------
# Site
# ---------------------------------------------------------------
# Public site address used in the sitemap, robots.txt and canonical links.
# Default: https://anarock.com
NEXT_PUBLIC_BASE_URL=

# Optional. Number of proxies in front of the app that add an entry to
# X-Forwarded-For, used to find the real visitor IP for rate limits.
# Default: 1
TRUSTED_PROXY_COUNT=

# ---------------------------------------------------------------
# Optional cache times, in seconds
# ---------------------------------------------------------------
# Default: 21600 (6 hours)
CITIES_CACHE_TTL=
# Default: 21600 (6 hours)
MICROMARKETS_CACHE_TTL=
# Default: 21600 (6 hours)
KYC_CACHE_TTL=
